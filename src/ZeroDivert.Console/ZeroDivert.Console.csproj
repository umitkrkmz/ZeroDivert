<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>ZeroDivert</Product>
    <Company>Umit Korkmaz</Company>
    <Copyright>Copyright © 2025-2026 Umit Korkmaz</Copyright>
    <Description>ZeroDivert - Discord DPI Bypass Tool</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroDivert.Core\ZeroDivert.Core.csproj" />
    <ProjectReference Include="..\ZeroDivert.Driver\ZeroDivert.Driver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <!--
    License files shipped next to the exe in every release package (portable zip
    and installer). Kept out of the single-file bundle so users can read them.
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
